# Copy to the runtime directory as server.env, owner-readable only (chmod 600).
# Generate your own token: openssl rand -hex 32
NAS_PHOTO_TOKEN=''
NAS_PHOTO_ROOT='/share/Photos'
NAS_PHOTO_LISTEN='192.168.1.10:8791'
# Optional AI queue; serving is a separate, explicit switch.
NAS_PHOTO_OUTPAINT=0
NAS_PHOTO_OUTPAINT_AUTOFILL=0
NAS_PHOTO_OUTPAINT_SERVE=0
# Capture-date filter uses EXIF DateTimeOriginal, never file modification time.
NAS_PHOTO_MAX_AGE_YEARS=10
# Versioned completed batches: no raw-photo fill while this mode is enabled.
NAS_PHOTO_BATCH_PUBLISH=0
# Set to the recipe key reported by the Mac worker/control program before enabling.
NAS_PHOTO_PUBLISH_WORKFLOW=''
